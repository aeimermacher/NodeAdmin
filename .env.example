# Output of: npm run hash-password
ADMIN_PASSWORD_HASH=
HOST=127.0.0.1
PORT=2000
# Set to true when served over HTTPS (e.g. behind a TLS reverse proxy)
COOKIE_SECURE=false
# e.g. "loopback" when behind nginx/caddy on the same host
# TRUST_PROXY=loopback
# Node binary used for managed services (defaults to the one running NodeAdmin)
# NODE_BIN=/usr/bin/node

# Mail alerts when a service stops unexpectedly (disabled unless SMTP_HOST and ALERT_TO are set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS when offered
# SMTP_SECURE=false
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# ALERT_FROM=NodeAdmin <alerts@example.com>
# Comma-separated
# ALERT_TO=you@example.com
# MONITOR_INTERVAL_SECONDS=10
# ALERT_COOLDOWN_MINUTES=15
